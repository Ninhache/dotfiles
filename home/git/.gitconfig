[user]
	email = mr.carambar27@gmail.com
	name = Ninhache
[core]
	editor = vim
[init]
    defaultBranch = main

[includeIf "gitdir:~/pit_project/"]
    path = ~/.gitconfig-pit
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[include]
	path = ~/.gitconfig.local
